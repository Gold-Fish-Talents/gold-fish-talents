{
  "name": "gold-fish-talents",
  "version": "0.4.20",
  "description": "E2E platform empowering brands to discover, manage, and collaborate with creative talents",
  "author": "Shirsendu Bairagi <shirsendu2001@gmail.com>",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gold-Fish-Talents/gold-fish-talents.git"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": "^20.15.0 || ^22.11.0",
    "pnpm": "^9.15.0 || ^10.2.0",
    "bun": "^1.2.9"
  },
  "packageManager": "bun@1.4.3",
  "scripts": {
    "prepare": "husky || true",
    "postinstall": "nuxt prepare",
    "dev": "nuxt dev ",
    "detect": "gitleaks git --verbose",
    "lint": "eslint . --fix",
    "format": "prettier . --write",
    "test:load": "k6 run tests/load.test.ts",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "node --env-file=.env.prod .output/server/index.mjs",
    "clean": "nuxt cleanup && (cd src-tauri && cargo clean)",
    "docker:build": "docker build --build-arg VERSION=dev --build-arg BUILD_TIME=now -t gold-fish-talents:dev .",
    "docker:start": "docker run --detach --name gold-fish-talents-dev --env-file .env.prod -p 4000:3000 gold-fish-talents:dev",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:dev:mobile": "tauri android dev",
    "tauri:build:mobile": "tauri android build"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.37.0",
    "@hannoeru/nuxt-otel": "^0.0.8",
    "@notionhq/client": "^5.27.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/fonts": "^1.0.1",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/image": "^2.1.0",
    "@nuxt/scripts": "^1.3.12",
    "@nuxt/test-utils": "^4.3.3",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/mdc": "^0.23.2",
    "@nuxtjs/seo": "^6.0.1",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^1.0.3",
    "@regle/nuxt": "^1.29.5",
    "@tresjs/cientos": "^5.9.3",
    "@tresjs/nuxt": "^5.7.3",
    "@types/markdown-it": "^14.2.0",
    "@types/web-push": "^3.6.4",
    "@unhead/vue": "^3.4.3",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/components": "^15.0.0",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "date-fns": "^4.4.0",
    "markdown-it": "^15.0.3",
    "notion-to-md": "^3.1.9",
    "nuxt": "^4.6.1",
    "nuxt-auth-utils": "^0.5.31",
    "nuxt-maplibre": "^1.2.2",
    "pinia": "^4.1.0",
    "three": "^0.186.1",
    "typesense": "^3.1.1",
    "uncrypto": "^0.1.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/k6": "^2.3.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "happy-dom": "^21.0.3",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "esbuild",
    "protobufjs",
    "sharp",
    "unrs-resolver",
    "vue-demi"
  ]
}
